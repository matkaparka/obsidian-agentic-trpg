# 复制成 .env 后填入。.env 已在 .gitignore 里，不会进仓库、不会打印。
# Copy to .env and fill in. Never commit or log the values.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# 可选覆盖（不填就用 config/models.yaml 里的值）
# TRPG_GM_MODEL=
# TRPG_PLAYER_A_MODEL=
# TRPG_PLAYER_B_MODEL=
# TRPG_RENDERER_MODEL=

# Atlas agent link（token 在 campaign-vault\.obsidian\plugins\atlas-agent-link\data.json）
ATLAS_URL=http://127.0.0.1:27125
ATLAS_TOKEN=

# 正式 vault 的路径（剧本、角色卡、立绘都从这里读）
TRPG_CAMPAIGN_VAULT=../campaign-vault
